{
  "name": "omnes-inventory",
  "private": true,
  "version": "0.0.1",
  "description": "Multi-tenant inventory management for small and mid-size businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev --workspace=apps/api\" \"npm:dev --workspace=apps/web\"",
    "dev:marketing": "npm run dev --workspace=apps/marketing",
    "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace=apps/api",
    "db:seed": "dotenv -e .env -- npm run db:seed --workspace=apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "tsx": "^4.22.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
