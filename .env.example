# Copy this to .env and fill in what differs on your machine.

# Postgres connection string. The default matches docker-compose.yml.
# If you run Postgres natively instead of Docker, point this at your own instance,
# e.g. postgresql://postgres:yourpassword@localhost:5432/omnes_inventory
DATABASE_URL=postgresql://omnes:omnes@localhost:5432/omnes_inventory

# API
API_PORT=4000

# JWT secrets. Any long random string works for local dev.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Where uploaded files (product images, etc.) are stored in dev.
UPLOAD_DIR=./uploads

# Mail. Defaults match the Mailhog container from docker-compose.yml.
# Without Docker, set SMTP_TRANSPORT=console to log emails to the terminal instead.
SMTP_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@omnes.local

# Frontend
VITE_API_URL=http://localhost:4000

# Where the landing page sends people who sign up or sign in.
# Defaults to the local web app when unset.
VITE_APP_URL=http://localhost:5173
